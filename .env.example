# ─── Blynk IoT ───────────────────────────────────────────────────────────────
# Get your token from https://blynk.io → your project → Device Info
BLYNK_TOKEN=your_blynk_auth_token_here

# ─── Roboflow (only needed for training / downloading dataset) ────────────────
# Get from https://app.roboflow.com → Account → Settings → Roboflow API
ROBOFLOW_API_KEY=your_roboflow_api_key_here

# ─── Raspberry Pi Serial Port ─────────────────────────────────────────────────
# Common values: /dev/ttyUSB0 (USB-to-serial) or /dev/ttyAMA0 (GPIO UART)
SERIAL_PORT=/dev/ttyUSB0
BAUD_RATE=9600

# ─── YOLOv8 Model Path ────────────────────────────────────────────────────────
MODEL_PATH=models/best.pt

# ─── Detection Confidence Threshold ──────────────────────────────────────────
CONF_THRESH=0.4
